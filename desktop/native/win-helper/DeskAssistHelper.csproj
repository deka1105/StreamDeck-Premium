<Project Sdk="Microsoft.NET.Sdk">
  <!--
    DeskAssist's Windows helper: Core Audio (devices, per-app sessions, meters,
    default device), DDC/CI monitor brightness, lock and sleep. One small native
    .exe (NativeAOT: no .NET runtime needed on the user's PC), driven by the
    host over stdin/stdout with one JSON object per line.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>DeskAssistHelper</AssemblyName>
    <RootNamespace>DeskAssist.Helper</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
