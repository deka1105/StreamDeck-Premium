# macOS
.DS_Store

# Signing material — private keys and certificates must never be committed.
# mobile/.gitignore covered these already; the repo root did not, so a .p12
# exported next to the desktop build would have been committable.
*.p12
*.pfx
*.p8
*.pem
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile

# Vercel
.vercel

# Local AI session transcripts — contain personal paths/emails, not part of the project
session-logs/

# desktop/build/ is electron-builder's `buildResources` dir — hand-written
# SOURCE, not output. The blanket `build/` rule above was hiding the notarize
# afterSign hook and the hardened-runtime entitlements plist, so a fresh clone
# could not produce a signable macOS build at all. icon.png in there is
# generated by `npm run gen:icon`, but that generator is deterministic and the
# build config needs the file, so it's tracked too. (Real output goes to
# desktop/dist/, which `dist/` already covers.)
!desktop/build/

# Hyperframes render scratch — thousands of throwaway frame JPGs per render.
# The watcher committed one of these mid-render last time; excluding it also
# keeps the capture workers' temp dirs out of the tree.
brag-output/work-*/
brag-output/composition/renders/
brag-output/composition/.debug/
