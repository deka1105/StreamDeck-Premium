{
  "version": 1,
  "templates": [
    {
      "id": "home",
      "name": "Home",
      "description": "Clock, weather, computer load and your deck tiles.",
      "page": {
        "name": "Home",
        "widgets": [
          {
            "type": "clock",
            "x": 0,
            "y": 0,
            "w": 4,
            "h": 3
          },
          {
            "type": "weather",
            "x": 4,
            "y": 0,
            "w": 4,
            "h": 3
          },
          {
            "type": "metric",
            "x": 8,
            "y": 0,
            "w": 2,
            "h": 3,
            "options": {
              "source": "cpu"
            }
          },
          {
            "type": "metric",
            "x": 10,
            "y": 0,
            "w": 2,
            "h": 3,
            "options": {
              "source": "mem"
            }
          },
          {
            "type": "deck",
            "x": 0,
            "y": 3,
            "w": 12,
            "h": 3
          }
        ]
      }
    },
    {
      "id": "system",
      "name": "System",
      "description": "CPU, GPU, memory and network over time, disks and latency.",
      "page": {
        "name": "System",
        "widgets": [
          {
            "type": "chart",
            "x": 0,
            "y": 0,
            "w": 4,
            "h": 2,
            "options": {
              "source": "cpu",
              "window": "180"
            }
          },
          {
            "type": "chart",
            "x": 4,
            "y": 0,
            "w": 4,
            "h": 2,
            "options": {
              "source": "gpu",
              "source2": "vram",
              "window": "180"
            }
          },
          {
            "type": "chart",
            "x": 8,
            "y": 0,
            "w": 4,
            "h": 2,
            "options": {
              "source": "mem",
              "source2": "swap",
              "window": "180"
            }
          },
          {
            "type": "chart",
            "x": 0,
            "y": 2,
            "w": 6,
            "h": 2,
            "options": {
              "source": "netDown",
              "source2": "netUp",
              "window": "180"
            }
          },
          {
            "type": "chart",
            "x": 6,
            "y": 2,
            "w": 3,
            "h": 2,
            "options": {
              "source": "ping",
              "window": "180"
            }
          },
          {
            "type": "metric",
            "x": 9,
            "y": 2,
            "w": 3,
            "h": 2,
            "options": {
              "source": "cpuTemp"
            }
          },
          {
            "type": "storage",
            "x": 0,
            "y": 4,
            "w": 6,
            "h": 2
          },
          {
            "type": "gpu",
            "x": 6,
            "y": 4,
            "w": 6,
            "h": 2
          }
        ]
      }
    },
