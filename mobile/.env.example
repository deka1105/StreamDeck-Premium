# RevenueCat public SDK keys. Copy to `.env.local` and fill in from
# RevenueCat → Project settings → API keys → "Public app-specific" keys.
#
# These are *client* keys and ship inside the app binary, so they aren't secrets
# in the usual sense — but keep them out of git so a fork doesn't bill against
# this project. With neither set, the app runs entirely on the free tier and the
# paywall says so instead of crashing.
#
# For EAS cloud builds, register them once instead of committing:
#   eas env:create --name EXPO_PUBLIC_REVENUECAT_IOS_KEY --value appl_xxx --environment production
#   eas env:create --name EXPO_PUBLIC_REVENUECAT_ANDROID_KEY --value goog_xxx --environment production

EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
