{
  "name": "ExpoCameraBarcodeScanning",
  "version": "57.0.3",
  "summary": "ZXing-based barcode scanning provider for expo-camera",
  "description": "Provides PDF417, Code39, and Codabar barcode scanning via ZXingObjC for expo-camera",
  "license": "MIT",
  "authors": "650 Industries, Inc.",
  "homepage": "https://docs.expo.dev/versions/latest/sdk/camera/",
  "platforms": {
    "ios": "16.4"
  },
  "swift_versions": "5.9",
  "source": {
    "git": "https://github.com/expo/expo.git"
  },
  "static_framework": true,
  "dependencies": {
    "ExpoCamera": [],
    "ZXingObjC/PDF417": [],
    "ZXingObjC/OneD": []
  },
  "source_files": "barcode-scanning/**/*.swift",
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES",
    "GCC_PREPROCESSOR_DEFINITIONS": "ZXINGOBJC_USE_SUBSPECS ZXINGOBJC_PDF417 ZXINGOBJC_ONED",
    "SWIFT_COMPILATION_MODE": "wholemodule"
  },
  "swift_version": "5.9"
}
